# ============================================================
# 饶信谱脉后端环境变量
# 用法：复制本文件为 .env 再改
#   cp .env.example .env
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
DEBUG=true

# JWT 签名密钥。生产环境必须换成随机长字符串：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-please-change-me
ACCESS_TOKEN_EXPIRE_DAYS=7

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=raoxin_genealogy
DB_CHARSET=utf8mb4

# ---------- 微信小程序 ----------
# 还没注册小程序时留空即可，并把 WX_MOCK_LOGIN 设为 true
WX_APPID=
WX_SECRET=

# 开发期模拟登录：不调微信接口，直接用 code 派生一个稳定的假 openid。
# 小程序端在开发者工具里勾选"不校验合法域名"就能联调。
# 上线前必须改为 false。
WX_MOCK_LOGIN=true
