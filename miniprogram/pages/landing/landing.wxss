.page {
  min-height: 100vh;
  background: var(--paper);
  padding-bottom: 40rpx;
}

/* ============ 祠堂门厅 ============
   组件里写颜色字面量，不用 var()（样式作用域独立，见决策）。
   底图 images/hall-bg.jpg（95KB，自带空白黛青匾）。
   关键：widthFix 完整显示不裁切——屏宽变了匾的位置只按比例缩放，
   文字层用同样的百分比就能永远落在匾面上。换家族只换字，图不换。 */

.hall {
  position: relative;
  line-height: 0;   /* 消掉 image 基线空隙，否则图下有一条纸色缝 */
}

.hall-bg {
  width: 100%;
  height: 792rpx;   /* 900:950 图（已裁到门槛下两行空白），宽 750rpx 时高 792rpx */
}

/* 匾面文字层：对准底图上的空匾（金框内沿 x 20.8%-78.9% / y 11.8%-32.5%）。
   只放堂号 + 族名；统计信息按需求移到下半部分。 */
.plaque-text {
  position: absolute;
  left: 23%;
  right: 23%;
  top: 13%;
  height: 17.6%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}

.plaque-tang {
  font-size: 21rpx;
  color: #E9D7A6;
  letter-spacing: 5rpx;
  line-height: 1.3;
  opacity: 0.92;
}

/* 族名两道保障：字号取 44rpx——七字族名（如"广信陈氏谱牒"）
   加字距刚好落在匾面宽内；字距负补偿最后一位的 letter-spacing。 */
.plaque-name {
  font-size: 44rpx;
  font-weight: 600;
  color: #E9D7A6;
  letter-spacing: 5rpx;
  text-indent: 5rpx;   /* 抵消末字右侧字距，视觉居中 */
  line-height: 1.25;
  text-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.55);
}

/* 底部融合：图底已是米色纸感，只轻轻一层把图的米色接进页面纸色 */
.hall-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8%;
  background: linear-gradient(180deg, rgba(246, 243, 234, 0) 0%, rgba(246, 243, 234, 0.75) 70%, #F6F3EA 100%);
}

/* ---------- 下半部分：统计 + 邀请人（纸色区） ---------- */

.under-hall {
  padding: 0 48rpx 24rpx;
  text-align: center;
}

/* 统计信息条：细金线短竖线做分隔，比"·"更齐整 */
.hall-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 26rpx;
  color: #4A473F;
  letter-spacing: 1rpx;
}

.hall-stat-sep {
  width: 1rpx;
  height: 24rpx;
  background: linear-gradient(180deg, transparent, #C9A961, transparent);
}

.hall-founder {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B675C;
}

/* ---------- 邀请人 ---------- */

.hall-foot {
  margin-top: 34rpx;
}

.inviter-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
}

.inviter-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2B2A25;
}

.inviter-txt {
  font-size: 28rpx;
  color: #6B675C;
}

.inviter-note {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #4A473F;
  line-height: 1.6;
}

.inviter-anchor {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #6B675C;
}

.inviter-anchor-name {
  color: #A6321E;
  font-weight: 600;
}

/* ============ 范围 ============ */

.scope-summary {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
}

.scope-tip {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

/* ============ 底部 ============ */

.ft-gap {
  height: 40rpx;
}

.ft {
  padding: 0 40rpx;
}

.ft-btn {
  width: 100%;
}

.ft-sub {
  margin-top: 22rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--ink-3);
  text-decoration: underline;
}

/* "换一个家族码"：走错族的出口，比主按钮更轻，不要下划线抢注意力 */
.ft-sub-quiet {
  text-decoration: none;
  color: var(--ink-3);
}

/* ============ 状态 ============ */

.loading {
  padding: 80rpx 40rpx;
}

.sk-l {
  height: 44rpx;
  margin-bottom: 26rpx;
}

.sk-tall {
  height: 90rpx;
  width: 70%;
  margin-bottom: 34rpx;
}

.sk-short {
  width: 55%;
}

.loading-tip {
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-3);
  margin-top: 40rpx;
}

/* ============ 态 B：输码进族 ============ */

.gate {
  padding: 96rpx 40rpx 36rpx;
  text-align: center;
}

.gate-mark {
  font-size: 76rpx;
  color: var(--line-2);
  line-height: 1;
  margin-bottom: 28rpx;
}

.gate-title {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.gate-sub {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: var(--ink-3);
}

.field-label {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 14rpx;
}

/* 码是给长辈手输的：字要大、间距拉开、字母数字都看得清 */
.code-input {
  height: 96rpx;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 0 28rpx;
  font-size: 36rpx;
  letter-spacing: 6rpx;
  color: var(--ink);
}

.code-ph {
  color: var(--line-2);
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.code-err {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--seal);
  line-height: 1.6;
}

.gate-btn {
  margin-top: 28rpx;
  width: 100%;
}

.why-item {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.9;
}
