<!--
  待办。
  为什么把它抬成一级 tab：这个产品的回访理由只有一个——"我这一格还缺东西"。
  藏在首页底部的提示条里，用户第二次打开就找不到了；抬成 tab 之后，
  它每次都在那儿，而且可以带数字角标。

  这一页只做三件事：
    1. 我这一格的完整度（有尽头感）
    2. 现在就能补的 3 条（一次不给 20 条，那是列表不是引导）
    3. 没认领 / 没入族时的两条出路
-->
<view class="page">

  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="skeleton sk-card" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <!-- 没入族 -->
  <view wx:elif="{{needFamily}}" class="empty">
    <view class="empty-mark">谱</view>
    <view>还没有进入任何家族</view>
    <view class="empty-hint">输入家族码，或者让家里人把邀请发给你</view>
    <view class="btn btn-primary btn-sm empty-btn" bindtap="goLanding">去输入家族码</view>
  </view>

  <!-- 入族了但没认领 -->
  <view wx:elif="{{needClaim}}" class="empty">
    <view class="empty-mark">?</view>
    <view>还不知道您是哪一位</view>
    <view class="empty-hint">答两个名字就能对上「我」，之后这里会列出您这一格缺什么</view>
    <view class="btn btn-primary btn-sm empty-btn" bindtap="goClaim">确认我的身份</view>
  </view>

  <block wx:else>
    <!-- 完整度 -->
    <view class="card progress-card">
      <view class="row-between">
        <view class="pc-name">{{displayName || '我'}}</view>
        <view class="pc-pct">{{percent}}%</view>
      </view>
      <view class="pc-bar"><view class="pc-fill" style="width:{{percent}}%"></view></view>
      <view class="pc-sub" wx:if="{{missingCount > 0}}">还差 {{missingCount}} 项，补完后代才找得到他们</view>
      <view class="pc-sub pc-done" wx:else>您这一格已经完整了</view>
    </view>

    <!-- 现在就能补的 -->
    <block wx:if="{{items.length}}">
      <view class="sec-title">现在能补</view>
      <view
        class="card task"
        wx:for="{{items}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTask"
      >
        <view class="task-q">{{item.question}}</view>
        <view class="task-go">去补 →</view>
      </view>
    </block>

    <view wx:else class="card done-card">
      <view class="done-t">暂时没有可补的了</view>
      <view class="done-s">点下面看看还能帮谁补一条</view>
    </view>

    <view class="btn btn-ghost btn-sm next-btn" bindtap="goFill">逐条补完（一次一问）</view>

    <view class="tip">同一格被多人填过时，以房长审核通过的为准；您填的会留修订记录，可回滚。</view>
  </block>
</view>
