.page {
  min-height: 100vh;
  background: var(--paper);
}

/* ============ 头部 ============ */

.hero {
  padding: 56rpx 40rpx 36rpx;
  background: linear-gradient(180deg, #EDE8DB 0%, var(--paper) 100%);
}

.hero-family {
  font-size: 26rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

.hero-q {
  margin-top: 14rpx;
  font-size: 52rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
  line-height: 1.35;
}

.hero-sub {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.hero-meta {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ============ 提示条 ============ */

.note {
  margin: 24rpx 28rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 16rpx;
  background: var(--dai-bg);
  border: 1rpx solid #EBD3CC;
}

.note-warn {
  background: #FBF6EC;
  border-color: #EADCC0;
}

.note-t {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.6;
}

.note-s {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* ============ 选项 ============ */

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 0 30rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  background: var(--paper-2);
  border: 2rpx solid transparent;
  font-size: 30rpx;
  color: var(--ink-2);
}

.chip-on {
  background: var(--dai-bg);
  border-color: var(--dai);
  color: var(--dai);
  font-weight: 600;
}

.mt-14 { margin-top: 14rpx; }
.mt-16 { margin-top: 16rpx; }

/* ============ 输入 ============ */

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 27rpx;
  color: var(--ink-2);
  margin-bottom: 14rpx;
}

.field-input {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  background: var(--paper-2);
  border-radius: 14rpx;
  padding: 0 26rpx;
  font-size: 34rpx;
  color: var(--ink);
}

.ph {
  color: #B3ABA0;
  font-size: 30rpx;
}

.field-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

.extra-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title.no-mb {
  margin-bottom: 0;
}

.extra-toggle {
  font-size: 26rpx;
  color: var(--dai);
  flex-shrink: 0;
}

/* ============ 说明 ============ */

.safe-item {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.9;
}

/* ============ 完成态 ============ */

.done {
  padding: 110rpx 54rpx 0;
  text-align: center;
}

.done-mark {
  width: 130rpx;
  height: 130rpx;
  margin: 0 auto 40rpx;
  border-radius: 50%;
  background: #E7EFEA;
  color: var(--jade);
  font-size: 68rpx;
  line-height: 130rpx;
}

.done-mark-warn {
  background: #FBF6EC;
  color: var(--warn);
}

.done-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.5;
}

.done-name {
  margin-top: 22rpx;
  font-size: 52rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 3rpx;
}

.done-gen {
  margin-left: 14rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-3);
  letter-spacing: 0;
}

.done-sub {
  margin-top: 22rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.75;
}

/* 补全「配某氏」的前后对比 */

.filled {
  margin-top: 46rpx;
  padding: 30rpx 24rpx;
  background: #F7F0DC;
  border-radius: 18rpx;
}

.filled-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.filled-before {
  font-size: 34rpx;
  color: var(--ink-3);
  text-decoration: line-through;
}

.filled-arrow {
  font-size: 30rpx;
  color: var(--warn);
}

.filled-after {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.filled-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--warn);
}

.granted {
  margin-top: 34rpx;
  font-size: 25rpx;
  color: var(--ink-3);
}

/* ============ 其他 ============ */

.ft-gap {
  height: 220rpx;
}

.ft {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx 24rpx;
  background: rgba(251, 248, 243, 0.97);
  border-top: 1rpx solid var(--line);
}

.loading {
  padding: 80rpx 40rpx;
}

.sk-h {
  height: 90rpx;
  width: 50%;
  margin: 0 auto 34rpx;
}

.sk-l {
  height: 38rpx;
  margin-bottom: 24rpx;
}

.sk-short {
  width: 60%;
  margin: 0 auto;
}
