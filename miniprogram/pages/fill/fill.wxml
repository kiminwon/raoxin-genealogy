<!--
  待补全清单。
  这个页面的成败决定整个产品能不能起来——

  行业里绝大多数家谱产品都死在同一件事上：给用户一张空白表单。
  用户打开，看到两百个格子，关掉，再也不来。

  这里的做法正相反：系统先算出"这个人周围还缺什么"，
  然后一次只问一个问题，并且明确告诉他「为什么问」「填完会变成什么样」。
-->
<view class="page">

  <!-- ============ 加载 ============ -->
  <view wx:if="{{loading}}" class="loading">
    <view class="skeleton sk-q"></view>
    <view class="skeleton sk-l"></view>
    <view class="skeleton sk-l sk-short"></view>
  </view>

  <!-- ============ 不是自己的清单 ============ -->
  <view wx:elif="{{forbidden}}" class="empty">
    <view class="empty-mark">谱</view>
    <view>{{forbiddenMsg}}</view>
    <view class="btn btn-ghost btn-sm empty-btn" bindtap="onGoHome">回族谱</view>
  </view>

  <!-- ============ 这一轮结束（服务端复核后才说"补全"，见 fill.js::_showDone） ============ -->
  <view wx:elif="{{done}}" class="done">
    <!-- 还有余项时故意不画那个勾：勾是"完成了"，这里只是"这轮问完了" -->
    <view wx:if="{{!doneMore}}" class="done-mark">✓</view>
    <view class="done-title">{{doneTitle}}</view>
    <view class="done-sub">{{doneSub}}</view>
    <view wx:if="{{doneMore}}" class="btn btn-primary done-btn" bindtap="onContinue">接着补</view>
    <view class="btn {{doneMore ? 'btn-ghost' : 'btn-primary'}} done-btn" bindtap="onGoHome">回族谱</view>
    <view wx:if="{{!doneMore}}" class="done-tip">系统会继续检查您其他亲属的信息，有新发现的会再来找您。</view>
  </view>

  <!-- ============ 答题 ============ -->
  <block wx:else>
    <!-- 进度 -->
    <view class="prog">
      <view class="prog-bar">
        <view class="prog-fill" style="width:{{percent}}%"></view>
      </view>
      <view class="prog-txt">
        <text class="prog-name">{{displayName}}这一支</text>
        <text class="prog-num">还差 {{total}} 项</text>
      </view>
    </view>

    <!-- 问题 -->
    <view class="q">
      <view class="q-idx">第 {{index + 1}} 问</view>
      <view class="q-text">{{task.question}}</view>
      <view wx:if="{{task.reason}}" class="q-reason">{{task.reason}}</view>
    </view>

    <!--
      前后对比。这是整个产品最强的情绪点：
      用户看到的不是"输入框"，而是"配李氏 → 李秀英"，
      是一个被老谱省略掉的人被写回来。
    -->
    <view wx:if="{{task.displayBefore}}" class="before">
      <view class="before-row">
        <text class="before-k">谱上现在</text>
        <text class="before-v before-old">{{task.displayBefore}}</text>
      </view>
      <view class="before-arrow">↓</view>
      <view class="before-row">
        <text class="before-k">填完之后</text>
        <text class="before-v before-new">{{preview || '（您写的名字）'}}</text>
      </view>
      <view wx:if="{{task.hint}}" class="before-hint">{{task.hint}}</view>
    </view>

    <!-- 表单 -->
    <view class="card">
      <view wx:for="{{fields}}" wx:key="key" class="ff">
        <view class="ff-label">
          {{item.label}}
          <text wx:if="{{item.optional}}" class="ff-opt">选填</text>
        </view>

        <input
          wx:if="{{item.type === 'text'}}"
          class="ff-input"
          value="{{item.value}}"
          placeholder="{{item.placeholder}}"
          focus="{{index === 0 && autoFocus}}"
          data-index="{{index}}"
          bindinput="onInput"
        />

        <picker
          wx:elif="{{item.type === 'date'}}"
          mode="date"
          value="{{item.value || '1970-01-01'}}"
          start="1800-01-01"
          end="{{today}}"
          data-index="{{index}}"
          bindchange="onInput"
        >
          <view class="ff-picker">{{item.value || '点这里选择'}}</view>
        </picker>

        <picker
          wx:elif="{{item.type === 'picker'}}"
          range="{{item.labels}}"
          value="{{item.index}}"
          data-index="{{index}}"
          bindchange="onPick"
        >
          <view class="ff-picker">{{item.labels[item.index]}}</view>
        </picker>
      </view>

      <view wx:if="{{prefillTip}}" class="ff-tip">{{prefillTip}}</view>
    </view>

    <view class="ft-gap"></view>

    <!-- 底部 -->
    <view class="ft safe-bottom">
      <!-- 带 skipLabel 的（未婚 / 暂无子女）点了会落库，是"回答没有"而不是"以后再说"，
           所以文案直接用后端给的那句，别在这里写死。 -->
      <view
        wx:if="{{task.skippable}}"
        class="btn btn-plain {{submitting ? 'btn-disabled' : ''}}"
        bindtap="onSkip"
      >{{task.skipLabel || '以后再说'}}</view>
      <view class="btn btn-primary grow {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">
        {{submitting ? '记上了…' : '就这一条，记上'}}
      </view>
    </view>
  </block>

  <!-- 成功瞬间的浮层：给一个明确的"做完了"的反馈，人才会想做第二条 -->
  <view wx:if="{{flashShow}}" class="flash">
    <view class="flash-mark">✓</view>
    <view class="flash-txt">已记上</view>
  </view>
</view>
