.page {
  min-height: 100vh;
  background: var(--paper);
}

/* ============ 头部 ============ */

.hd {
  padding: 44rpx 40rpx 36rpx;
  background: linear-gradient(180deg, #EDE8DB 0%, var(--paper) 100%);
}

.hd-name-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.hd-name {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.hd-carry {
  font-size: 22rpx;
  color: var(--dai);
  border: 2rpx solid var(--dai);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  flex-shrink: 0;
}

.hd-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hd-life {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

/* ============ 关系链 ============ */

.rel-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.rel-row:last-child {
  margin-bottom: 0;
}

.rel-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--ink-3);
  line-height: 60rpx;
}

.rel-persons {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rel-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: var(--paper-2);
  border-radius: 10rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.4;
}

.rel-chip-name {
  color: var(--ink);
}

.rel-chip-tag {
  font-size: 20rpx;
  color: var(--warn);
  background: #F7F0DC;
  border-radius: 4rpx;
  padding: 0 6rpx;
}

/* ============ 本生与嗣 ============ */

.bio-note {
  font-size: 26rpx;
  color: var(--warn);
  margin-bottom: 16rpx;
}

.bio-line {
  display: flex;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.bio-k {
  width: 130rpx;
  flex-shrink: 0;
  color: var(--ink-3);
}

.bio-v {
  color: var(--dai);
  text-decoration: underline;
}

.bio-tip {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

/* ============ 字段 ============ */

.f-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EDE8DB;
  font-size: 29rpx;
}

.f-row:last-child {
  border-bottom: none;
}

.f-label {
  width: 170rpx;
  flex-shrink: 0;
  color: var(--ink-3);
}

.f-value {
  flex: 1;
  color: var(--ink);
  word-break: break-all;
  line-height: 1.6;
}

.f-empty {
  font-size: 27rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

/* ============ 待补全 ============ */

.pending {
  background: #FBF6EC;
  border-color: #E8DCC0;
}

.pending-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.pending-num {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--warn);
  line-height: 1;
}

.pending-txt {
  font-size: 30rpx;
  color: #8A6A24;
}

.pending-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #A08858;
}

/* ============ 底部 ============ */

.ft-gap {
  height: 200rpx;
}

.ft {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx 24rpx;
  background: rgba(251, 248, 243, 0.97);
  border-top: 1rpx solid var(--line);
}

/* ============ 编辑 ============ */

.edit-hd {
  padding: 40rpx 40rpx 8rpx;
}

.edit-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.edit-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.ef {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #EDE8DB;
}

.ef:last-of-type {
  border-bottom: none;
}

.ef-label {
  font-size: 27rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

.ef-opt {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-left: 10rpx;
}

.ef-input,
.ef-picker,
.ef-textarea {
  width: 100%;
  box-sizing: border-box;
  background: var(--paper-2);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.5;
}

.ef-input {
  height: 84rpx;
}

.ef-textarea {
  min-height: 140rpx;
}

.ef-picker {
  color: var(--ink);
}

.ef-hint {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

/* ============ 提示条 ============ */

.hint-bar {
  display: flex;
  gap: 16rpx;
  margin: 0 28rpx;
  padding: 22rpx 24rpx;
  background: #FBF6EC;
  border: 1rpx solid #E8DCC0;
  border-radius: 14rpx;
}

.hint-ico {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8A6A24;
  background: #F0E4C8;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  height: 32rpx;
  line-height: 24rpx;
}

.hint-txt {
  font-size: 26rpx;
  color: #8A6A24;
  line-height: 1.6;
}

/* ============ 加载 ============ */

.loading {
  padding: 80rpx 40rpx;
}

.sk-h {
  height: 74rpx;
  width: 55%;
  margin-bottom: 34rpx;
}

.sk-l {
  height: 38rpx;
  margin-bottom: 24rpx;
}

.sk-short {
  width: 60%;
}
