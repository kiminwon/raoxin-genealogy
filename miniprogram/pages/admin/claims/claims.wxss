/* 认领审核队列 */

.page {
  min-height: 100vh;
  padding: 0 28rpx 60rpx;
  box-sizing: border-box;
  background: var(--paper);
}

/* ---------- tab ---------- */

.tabs {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 2rpx 20rpx;
}

.tab {
  padding: 12rpx 26rpx;
  font-size: 27rpx;
  color: var(--ink-3);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
}

.tab-on {
  color: #E9D7A6;
  background: var(--dai);
  border-color: var(--dai);
}

.tab-count {
  margin-left: 8rpx;
  font-size: 23rpx;
}

/* ---------- 卡片 ---------- */

.skeleton-wrap { padding-top: 8rpx; }
.sk-block { height: 150rpx; border-radius: 18rpx; margin-bottom: 18rpx; }

.cc {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.cc-open {
  border-color: var(--dai-3);
}

.cc-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 24rpx;
}

.cc-ava {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--dai);
  background: var(--dai-bg);
}

.cc-main { flex: 1; min-width: 0; }

.cc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.cc-gen {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
}

.cc-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

.cc-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.cc-result {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ---------- 展开 ---------- */

.cc-body {
  padding: 4rpx 24rpx 20rpx;
  border-top: 1rpx solid var(--line);
}

.kv {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 12rpx 0;
}

.k {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

.v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.7;
  word-break: break-all;
}

.cc-acts {
  display: flex;
  gap: 14rpx;
  padding: 0 24rpx 22rpx;
}

.act {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 29rpx;
  letter-spacing: 3rpx;
}

.act-main {
  background: var(--dai);
  color: #E9D7A6;
}

.act-ghost {
  color: var(--ink-2);
  border: 1rpx solid var(--line-2);
}

.act-danger {
  color: var(--seal);
  border: 1rpx solid rgba(166, 50, 30, 0.4);
  background: var(--seal-bg);
}

.act-note {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

.foot {
  margin-top: 26rpx;
  padding: 0 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  line-height: 1.8;
  text-align: center;
}
