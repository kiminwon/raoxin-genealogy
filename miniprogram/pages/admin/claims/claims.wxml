<!--
  认领审核队列。

  三个 tab 对应三种状态：待审 / 已通过 / 已驳回。
  一张卡片上必须先回答理事会长最关心的两件事：
    ① 这个人要认领谁（节点名 + 第几世 + 父亲是谁）
    ② 他凭什么（答题自证答了什么、证据强度）
  然后才是动作。顺序错了就会出现"看都没看就通过"。

  驳回必须写理由——理由会通知到申请人，这不是内部备注。
-->
<view class="page">

  <!-- tab -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab {{status === item.value ? 'tab-on' : ''}}"
      data-value="{{item.value}}"
      bindtap="onSwitchTab"
    >{{item.label}}<text wx:if="{{item.count}}" class="tab-count">{{item.count}}</text></view>
  </view>

  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="skeleton sk-block" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <block wx:else>
    <view wx:if="{{!items.length}}" class="empty">
      <view class="empty-mark">谱</view>
      <view class="t-sub">{{emptyText}}</view>
    </view>

    <view
      wx:for="{{items}}"
      wx:key="claimId"
      class="cc {{item.open ? 'cc-open' : ''}}"
    >
      <!-- 主行 -->
      <view class="cc-head" data-id="{{item.claimId}}" bindtap="onToggle">
        <view class="cc-ava">{{item.initial}}</view>
        <view class="cc-main">
          <view class="cc-name">
            {{item.personName || '（节点已不可见）'}}
            <text wx:if="{{item.personGenerationLabel}}" class="cc-gen">{{item.personGenerationLabel}}</text>
          </view>
          <view class="cc-sub">
            <text>{{item.verifyMethodText}}</text>
            <text wx:if="{{item.applicantNickname}}"> · 申请人 {{item.applicantNickname}}</text>
            <text wx:if="{{item.timeText}}"> · {{item.timeText}}</text>
          </view>
        </view>
        <view class="cc-side">
          <text wx:if="{{item.strengthText}}" class="tag {{item.strengthClass}}">{{item.strengthText}}</text>
          <text wx:if="{{item.resultText && status !== 1}}" class="cc-result">{{item.resultText}}</text>
        </view>
      </view>

      <!-- 展开 -->
      <block wx:if="{{item.open}}">
        <view class="cc-body">
          <view class="kv">
            <text class="k">要认领</text>
            <text class="v">{{item.personName || '—'}}<text wx:if="{{item.fatherName}}">（父：{{item.fatherName}}）</text></text>
          </view>
          <view class="kv" wx:if="{{item.answersText}}">
            <text class="k">他答的是</text>
            <text class="v">{{item.answersText}}</text>
          </view>
          <view class="kv" wx:if="{{item.evidenceStrength}}">
            <text class="k">证据强度</text>
            <text class="v">{{item.evidenceStrength}}<text wx:if="{{item.verifyAnswers.evidenceNote}}"> · {{item.verifyAnswers.evidenceNote}}</text></text>
          </view>
          <view class="kv" wx:if="{{item.reviewNote}}">
            <text class="k">审核意见</text>
            <text class="v">{{item.reviewNote}}</text>
          </view>
          <view class="kv" wx:if="{{item.reviewerNickname}}">
            <text class="k">经办人</text>
            <text class="v">{{item.reviewerNickname}}<text wx:if="{{item.reviewedTimeText}}"> · {{item.reviewedTimeText}}</text></text>
          </view>
        </view>

        <!-- 动作：动作跟着状态走，不给人点了报错的按钮（决策 20） -->
        <view class="cc-acts">
          <block wx:if="{{status === 1}}">
            <view class="act act-ghost" data-id="{{item.claimId}}" data-name="{{item.personName}}" bindtap="onReject">驳回</view>
            <view class="act act-main" data-id="{{item.claimId}}" data-name="{{item.personName}}" bindtap="onApprove">通过</view>
          </block>
          <view
            wx:elif="{{status === 2}}"
            class="act act-danger"
            data-id="{{item.claimId}}"
            data-name="{{item.personName}}"
            bindtap="onRevert"
          >撤销这次认领</view>
          <view wx:else class="act-note">个案已结束，无需处理</view>
        </view>
      </block>
    </view>

    <view wx:if="{{items.length}}" class="foot">
      <text wx:if="{{status === 1}}">通过即生效，并通知申请人；拿不准就驳回并写清要补什么。</text>
      <text wx:else>撤销只收回这次认领带来的编辑权，不删除他做过的任何改动。</text>
    </view>
  </block>
</view>
