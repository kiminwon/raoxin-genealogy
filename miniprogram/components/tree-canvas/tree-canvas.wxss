/* 组件宿主必须自己撑满：默认的 inline 元素高度是 0，
   canvas 的 100% 会算成 0，屏幕上就是一片空白（这个坑很安静） */
:host {
  display: block;
  width: 100%;
  height: 100%;
}

.ov {
  width: 100%;
  height: 100%;
  display: block;
}

.ov-hint {
  position: absolute;
  left: 50%;
  bottom: 28rpx;
  transform: translateX(-50%);
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(20, 26, 36, 0.72);
  color: #fff;
  font-size: 24rpx;
  white-space: nowrap;
  pointer-events: none;
}

.ov-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 40%;
  text-align: center;
  color: #85817A;
  font-size: 28rpx;
}
